{
  "name": "claude-window",
  "version": "0.5.1",
  "description": "Pin your Claude Code 5-hour rate-limit window to a fixed hour",
  "license": "MIT",
  "author": "axelhamil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axelhamil/claude-window.git"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "rate-limit",
    "cli"
  ],
  "type": "module",
  "bin": {
    "claude-window": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "build": "bun build src/cli.ts --target=node --outfile dist/cli.js --minify",
    "dev": "bun run src/cli.ts",
    "analyze": "node scripts/analyze-usage.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --fix",
    "format": "biome format --write",
    "check": "biome check && pnpm typecheck && pnpm test && pnpm build",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
