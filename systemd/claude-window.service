[Unit]
Description=Pin the Claude Code 5h rate-limit window
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_USER
EnvironmentFile=REPLACE_HOME/.config/claude-window/env
ExecStart=REPLACE_HOME/.local/bin/claude-window daemon
Restart=always
RestartSec=60
Nice=10
MemoryMax=48M

[Install]
WantedBy=multi-user.target
