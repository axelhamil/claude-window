#!/usr/bin/env bash
set -euo pipefail

readonly VERSION=0.3.0
readonly REPO=https://github.com/axelhamil/claude-window.git
readonly ENDPOINT=https://api.anthropic.com/v1/messages
readonly WINDOW_SECONDS=18000
readonly RETRY_DELAY=300

readonly CONFIG_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/claude-window
readonly STATE_FILE=${XDG_STATE_HOME:-$HOME/.local/state}/claude-window/state
readonly SOURCE_FILE=$CONFIG_DIR/src

readonly OFFSET=${CLAUDE_WINDOW_OFFSET:-120}
readonly START_HOUR=${CLAUDE_WINDOW_START:-7}
readonly END_HOUR=${CLAUDE_WINDOW_END:-23}
readonly MODEL=${CLAUDE_WINDOW_MODEL:-claude-haiku-4-5-20251001}

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
die() { log "$*"; exit 1; }
clock() { date -d "@$1" +%H:%M; }

payload() {
  cat <<-JSON
	{"model":"$MODEL","max_tokens":1,
	 "system":[{"type":"text","text":"You are Claude Code, Anthropic's official CLI for Claude."}],
	 "messages":[{"role":"user","content":"hi"}]}
	JSON
}

header() {
  awk -F': ' -v key="$2" 'tolower($1) ~ key { gsub(/\r/, "", $2); print $2 }' "$1"
}

fetch_window() {
  local headers status reset
  headers=$(mktemp)
  trap 'rm -f "$headers"' RETURN

  status=$(curl -sS --max-time 30 -o /dev/null -D "$headers" -w '%{http_code}' \
    -X POST "$ENDPOINT" \
    -H "authorization: Bearer $CLAUDE_CODE_OAUTH_TOKEN" \
    -H "anthropic-version: 2023-06-01" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "content-type: application/json" \
    -d "$(payload)") || status=000

  reset=$(header "$headers" '5h-reset')
  if [[ $status != 200 && $status != 429 ]] || [[ ! $reset =~ ^[0-9]+$ ]]; then
    log "probe failed http=$status"
    return 1
  fi

  printf '%s %s %s\n' "$reset" \
    "$(header "$headers" '5h-utilization')" \
    "$(header "$headers" '7d-utilization')"
}

anchor() {
  local window reset usage5 usage7
  window=$(fetch_window) || return 1
  read -r reset usage5 usage7 <<<"$window"

  mkdir -p "$(dirname "$STATE_FILE")"
  printf '%s\n' "$window" >"$STATE_FILE"

  log "anchored $(clock "$((reset - WINDOW_SECONDS))")->$(clock "$reset") usage5=$usage5 usage7=$usage7"
  printf '%s\n' "$reset"
}

sleep_until() {
  local target=$1 seconds
  seconds=$(( target - $(date +%s) ))
  (( seconds > 0 )) || return 0
  log "sleeping ${seconds}s until $(clock "$target")"
  sleep "$seconds"
}

next_anchor_hour() {
  local hour
  hour=$(date +%-H)
  if (( hour < START_HOUR )); then
    date -d "today $START_HOUR:00" +%s
  else
    date -d "tomorrow $START_HOUR:00" +%s
  fi
}

within_active_hours() {
  local hour
  hour=$(date +%-H)
  (( hour >= START_HOUR && hour < END_HOUR ))
}

require_token() {
  [[ -n ${CLAUDE_CODE_OAUTH_TOKEN:-} ]] || die "CLAUDE_CODE_OAUTH_TOKEN is not set"
}

resolve_source() {
  local src
  src=$(cat "$SOURCE_FILE" 2>/dev/null) || src=
  if [[ -d $src/.git ]]; then
    printf '%s\n' "$src"
    return 0
  fi

  command -v git >/dev/null || die "git is required to update"
  src=${XDG_DATA_HOME:-$HOME/.local/share}/claude-window/src
  if [[ ! -d $src/.git ]]; then
    log "cloning $REPO"
    mkdir -p "$(dirname "$src")"
    git clone -q "$REPO" "$src" || die "clone failed"
  fi
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$src" | tee "$SOURCE_FILE"
}

cmd_status() {
  local reset usage5 usage7
  read -r reset usage5 usage7 <"$STATE_FILE" 2>/dev/null || die "no state yet"
  printf 'window -> reset %s (in %d min)\n' "$(clock "$reset")" "$(( (reset - $(date +%s)) / 60 ))"
  printf 'usage 5h %s | 7d %s\n' "$usage5" "$usage7"
}

cmd_update() {
  local src target
  src=$(resolve_source)
  git -C "$src" pull -q --ff-only || die "pull failed, check $src"

  target=$(awk -F= '/^readonly VERSION=/ { print $2; exit }' "$src/claude-window")
  if [[ $VERSION == "$target" ]] && cmp -s "$src/claude-window" "$0"; then
    echo "already up to date ($VERSION)"
    return 0
  fi

  "$src/install.sh"
  if systemctl is-active --quiet claude-window 2>/dev/null; then
    sudo systemctl restart claude-window
    echo "service restarted"
  fi
  echo "updated $VERSION -> $target"
}

run_once() {
  require_token
  anchor >/dev/null
}

run_daemon() {
  require_token
  while :; do
    if ! within_active_hours; then
      sleep_until "$(next_anchor_hour)"
      continue
    fi

    local reset
    if reset=$(anchor); then
      sleep_until "$((reset + OFFSET))"
    else
      log "retrying in ${RETRY_DELAY}s"
      sleep "$RETRY_DELAY"
    fi
  done
}

main() {
  case ${1:-daemon} in
    daemon)  run_daemon ;;
    once)    run_once ;;
    status)  cmd_status ;;
    update)  cmd_update ;;
    version) echo "claude-window $VERSION" ;;
    *)       die "usage: claude-window [daemon|once|status|update|version]" ;;
  esac
}

main "$@"
