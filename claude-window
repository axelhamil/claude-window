#!/usr/bin/env bash
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/claude-window"
STATE="$STATE_DIR/state"
OFFSET="${CLAUDE_WINDOW_OFFSET:-120}"
START_HOUR="${CLAUDE_WINDOW_START:-7}"
END_HOUR="${CLAUDE_WINDOW_END:-23}"
MODEL="${CLAUDE_WINDOW_MODEL:-claude-haiku-4-5-20251001}"
API="https://api.anthropic.com/v1/messages"

log() { printf '%s %s\n' "$(date '+%H:%M:%S')" "$*"; }
hm()  { date -d "@$1" '+%H:%M'; }

probe() {
  local hdr code
  hdr=$(mktemp)
  code=$(curl -sS -o /dev/null -D "$hdr" -w '%{http_code}' --max-time 30 \
    -X POST "$API" \
    -H "authorization: Bearer ${CLAUDE_CODE_OAUTH_TOKEN}" \
    -H "anthropic-version: 2023-06-01" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "content-type: application/json" \
    -d "{\"model\":\"$MODEL\",\"max_tokens\":1,\"system\":[{\"type\":\"text\",\"text\":\"You are Claude Code, Anthropic's official CLI for Claude.\"}],\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}]}") || code=000
  RESET=$(awk -F': ' 'tolower($0) ~ /5h-reset/     {gsub(/\r/,"",$2); print $2}' "$hdr")
  USAGE5=$(awk -F': ' 'tolower($0) ~ /5h-utilization/{gsub(/\r/,"",$2); print $2}' "$hdr")
  USAGE7=$(awk -F': ' 'tolower($0) ~ /7d-utilization/{gsub(/\r/,"",$2); print $2}' "$hdr")
  CODE="$code"
  rm -f "$hdr"
  [[ "$code" == 200 || "$code" == 429 ]] && [[ "$RESET" =~ ^[0-9]+$ ]]
}

nap() {
  local until=$1 d
  d=$(( until - $(date +%s) ))
  (( d > 0 )) || return 0
  log "sleeping ${d}s until $(hm "$until")"
  sleep "$d"
}

MODE="${1:-daemon}"

case "$MODE" in
  status)
    [[ -r $STATE ]] || { echo "no state yet"; exit 1; }
    read -r r u5 u7 _ < "$STATE"
    echo "window -> reset $(hm "$r") (in $(( (r - $(date +%s)) / 60 )) min)"
    echo "usage 5h ${u5} | 7d ${u7}"
    exit 0
    ;;
  once|daemon) ;;
  *) echo "usage: claude-window [daemon|once|status]"; exit 2 ;;
esac

[[ -n "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]] || { log "CLAUDE_CODE_OAUTH_TOKEN is not set"; exit 1; }
mkdir -p "$STATE_DIR"

while :; do
  hour=$(date +%-H)
  if (( hour < START_HOUR )); then
    nap "$(date -d "today ${START_HOUR}:00" +%s)"; continue
  fi
  if (( hour >= END_HOUR )); then
    nap "$(date -d "tomorrow ${START_HOUR}:00" +%s)"; continue
  fi

  if probe; then
    printf '%s %s %s\n' "$RESET" "$USAGE5" "$USAGE7" > "$STATE"
    log "anchored http=$CODE window $(hm "$((RESET-18000))")->$(hm "$RESET") usage5=$USAGE5 usage7=$USAGE7"
    [[ "$MODE" == once ]] && exit 0
    nap "$(( RESET + OFFSET ))"
  else
    log "probe failed http=$CODE retrying in 5min"
    [[ "$MODE" == once ]] && exit 1
    sleep 300
  fi
done
